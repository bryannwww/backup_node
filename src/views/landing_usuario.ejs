<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="rv-landing">
    <!-- HERO SECTION -->
    <section class="rv-hero" style="background-image: url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=2000&q=80');">
        <div class="rv-hero__scrim"></div>
        <div class="rv-hero__center">
            <span class="rv-eyebrow">Reserva. Disfruta. Vive la experiencia.</span>
            <h1 class="rv-headline">
                Tu mesa te espera,<br>
                nosotros la <em>preparamos</em>
            </h1>
            <p class="rv-hero__lede">
                Experiencias gastronómicas exclusivas en Medellín. Reserva tu mesa ideal en segundos y asegura una noche inolvidable.
            </p>
            <div class="rv-hero__actions">
                <% if (typeof usuarioId === 'undefined' || !usuarioId) { %>
                    <a href="/login" class="btn-gold"><i class="bi bi-calendar-event"></i> Reservar Mesa Ahora</a>
                    <a href="/login" class="btn-dark"><i class="bi bi-journal-richtext"></i> Iniciar Sesión</a>
                <% } else { %>
                    <a href="/dashboard" class="btn-gold"><i class="bi bi-shield-lock"></i> Ir a mi Panel</a>
                <% } %>
            </div>
        </div>
    </section>

    <!-- BOOKING BAR -->
    <section class="rv-bookingbar">
        <form action="/reservas/crear" method="POST" class="rv-bookingbar__form">
            <div class="rv-bookingbar__label">
                <i class="bi bi-calendar2-check"></i>
                <span>Haz tu reserva</span>
            </div>
            <div class="rv-bookingbar__field">
                <label for="fecha">Fecha</label>
                <input type="date" id="fecha" name="fecha" required>
            </div>
            <div class="rv-bookingbar__field">
                <label for="hora">Hora</label>
                <input type="time" id="hora" name="hora" required>
            </div>
            <div class="rv-bookingbar__field">
                <label for="cantidad_personas">Personas</label>
                <select id="cantidad_personas" name="cantidad_personas" required>
                    <option value="1">1 Persona</option>
                    <option value="2" selected>2 Personas</option>
                    <option value="4">4 Personas</option>
                    <option value="6">6+ Personas</option>
                </select>
            </div>
            <div class="rv-bookingbar__field">
                <label for="mesa">Área / Mesa</label>
                <select id="mesa" name="mesa">
                    <option value="Interior">Interior</option>
                    <option value="Terraza">Terraza</option>
                    <option value="VIP">Zona VIP</option>
                </select>
            </div>
            <button type="submit" class="rv-bookingbar__submit">Reservar</button>
        </form>
    </section>

    <!-- SECCIÓN MENÚ SENCILLO -->
    <section id="menu" style="padding: 70px 20px; max-width: 1100px; margin: 0 auto; width: 100%; box-sizing: border-box;">
        <div style="text-align: center; margin-bottom: 45px;">
            <span style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 3px; color: #c9a961; font-weight: 600;">Nuestra Carta</span>
            <h2 style="font-size: 2.5rem; font-weight: 300; margin: 8px 0 10px 0; color: #fff;">Menú de la Casa 🍽️</h2>
            <p style="color: #aaa; max-width: 600px; margin: 0 auto; font-size: 1rem;">Una muestra sencilla de nuestros platos más pedidos y recomendados por el chef.</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px;">
            <!-- Plato 1 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #ff6600; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🥩 Bandeja Paisa Especial</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Chicharrón crujiente, carne molida, frijoles caseros, arroz blanco, huevo frito y aguacate fresco.</p>
                </div>
                <span style="color: #ff6600; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$38.000</span>
            </div>

            <!-- Plato 2 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #c9a961; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🔥 Lomo al Trapo</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Corte tierno de lomo fino sellado a la brasa, acompañado de papas rústicas al romero.</p>
                </div>
                <span style="color: #c9a961; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$42.000</span>
            </div>

            <!-- Plato 3 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #ff6600; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🦐 Cazuela de Mariscos</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Camarones y calamares en reducción de crema de coco con finas hierbas y patacones.</p>
                </div>
                <span style="color: #ff6600; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$45.000</span>
            </div>

            <!-- Plato 4 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #c9a961; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🥟 Empanadas Criollas (4 uds)</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Empanaditas de maíz crocante rellenas de carne desmechada, acompañadas de ají casero.</p>
                </div>
                <span style="color: #c9a961; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$16.000</span>
            </div>

            <!-- Plato 5 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #ff6600; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🥥 Limonada de Coco</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Bebida frappé refrescante elaborada con leche de coco natural y jugo fresco de limón.</p>
                </div>
                <span style="color: #ff6600; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$12.000</span>
            </div>

            <!-- Plato 6 -->
            <div style="background: #1a1a1a; padding: 22px; border-radius: 8px; border: 1px solid #2a2a2a; border-left: 4px solid #c9a961; display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                <div>
                    <h4 style="margin: 0 0 6px 0; font-size: 1.15rem; color: #fff;">🍮 Volcán de Arequipe</h4>
                    <p style="margin: 0; color: #888; font-size: 0.9rem; line-height: 1.4;">Postre caliente con corazón líquido de dulce de leche artesanal y helado de vainilla.</p>
                </div>
                <span style="color: #c9a961; font-weight: bold; font-size: 1.1rem; white-space: nowrap;">$15.000</span>
            </div>
        </div>
    </section>

    <!-- GALERÍA EDITORIAL -->
    <section class="rv-gallery">
        <div class="rv-gallery__intro">
            <span class="rv-eyebrow">¿Por qué elegirnos?</span>
            <h2>La experiencia ReserVa</h2>
        </div>
        <div class="rv-gallery__grid">
            <figure class="rv-gallery__item">
                <img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1400&q=80" alt="Ambiente">
                <figcaption>
                    <span class="rv-gallery__num">I.</span>
                    <h4>Ambiente Único</h4>
                    <p>Espacios diseñados para ofrecerte comodidad, elegancia y la mejor atmósfera de la ciudad.</p>
                </figcaption>
            </figure>
            <figure class="rv-gallery__item">
                <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=1200&q=80" alt="Carta premium">
                <figcaption>
                    <span class="rv-gallery__num">II.</span>
                    <h4>Carta Premium</h4>
                    <p>Cortes de carne seleccionados, platos de autor y una coctelería diseñada por expertos.</p>
                </figcaption>
            </figure>
            <figure class="rv-gallery__item">
                <img src="https://images.unsplash.com/photo-1470337458703-46ad1756a187?auto=format&fit=crop&w=1600&q=80" alt="Coctelería">
                <figcaption>
                    <span class="rv-gallery__num">III.</span>
                    <h4>Reserva Instantánea</h4>
                    <p>Olvídate de las filas. Elige tu mesa y asegura tu lugar en tiempo real.</p>
                </figcaption>
            </figure>
        </div>
    </section>

    <!-- CTA REGISTRO -->
    <% if (typeof usuarioId === 'undefined' || !usuarioId) { %>
    <section class="rv-cta">
        <div class="rv-cta__inner">
            <span class="rv-eyebrow">Membresía ReserVa</span>
            <h3>¿Aún no tienes una cuenta?</h3>
            <p>Regístrate hoy mismo para gestionar tus reservas, ver tu historial y recibir beneficios exclusivos.</p>
            <a href="/register" class="btn-gold">Crear una Cuenta</a>
        </div>
    </section>
    <% } %>

    <!-- TICKER -->
    <footer class="rv-ticker">
        <div class="rv-ticker__track">
            <div class="rv-ticker__set">
                <span><i class="bi bi-shield-check"></i> Reserva 100% Segura — Tus datos están protegidos</span>
                <span><i class="bi bi-lightning-charge"></i> Confirmación Inmediata — Recibe tu reserva al instante</span>
                <span><i class="bi bi-hand-thumbs-up"></i> Atención Personalizada — Estamos para ayudarte</span>
            </div>
            <div class="rv-ticker__set" aria-hidden="true">
                <span><i class="bi bi-shield-check"></i> Reserva 100% Segura — Tus datos están protegidos</span>
                <span><i class="bi bi-lightning-charge"></i> Confirmación Inmediata — Recibe tu reserva al instante</span>
                <span><i class="bi bi-hand-thumbs-up"></i> Atención Personalizada — Estamos para ayudarte</span>
            </div>
        </div>
    </footer>
</div>

<%- include('partials/footer') %>