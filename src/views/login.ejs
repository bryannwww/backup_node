<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>ReserVa - Iniciar Sesión</title>
    <style>
        body { font-family: Arial, sans-serif; background: #121212; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background: #1e1e1e; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.5); width: 320px; }
        input { width: 100%; padding: 10px; margin: 10px 0; background: #2a2a2a; border: 1px solid #444; color: #fff; border-radius: 4px; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background: #ff6600; border: none; color: white; font-weight: bold; border-radius: 4px; cursor: pointer; margin-top: 10px; }
        button:hover { background: #e05b00; }
        .error { color: #ff4d4d; font-size: 13px; margin-bottom: 10px; }
        h2 { color: #ff6600; margin-top: 0; }
        a { color: #ff6600; font-size: 13px; text-decoration: none; display: block; margin-top: 15px; text-align: center; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Iniciar Sesión 🚀</h2>
        <% if (error) { %> <div class="error"><%= error %></div> <% } %>
        <form action="/login" method="POST">
            <input type="email" name="email" placeholder="Correo electrónico" required>
            <input type="password" name="password" placeholder="Contraseña" required>
            <button type="submit">Entrar</button>
        </form>
        <a href="/register">¿No tienes cuenta? Regístrate aquí</a>
        <a href="/">← Volver al inicio</a>
    </div>
</body>
</html>