<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Gestión - ReserVa</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #121212;
            color: #fff;
            margin: 0;
            padding: 30px 20px;
        }

        .container {
            max-width: 900px;
            margin: auto;
            background: #1e1e1e;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #333;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        .header h2 {
            margin: 0;
            color: #ff9800;
        }

        .header small {
            color: #aaa;
            display: block;
            margin-top: 4px;
        }

        .btn-nav {
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 13px;
        }

        .btn-home {
            background: #333;
            color: #eee;
            margin-right: 8px;
        }

        .btn-home:hover {
            background: #444;
        }

        .btn-logout {
            background: #d32f2f;
            color: #fff;
        }

        .btn-logout:hover {
            background: #b71c1c;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background: #181818;
            border-radius: 6px;
            overflow: hidden;
        }

        th,
        td {
            padding: 12px 14px;
            border-bottom: 1px solid #2c2c2c;
            text-align: left;
            font-size: 14px;
        }

        th {
            background: #272727;
            color: #ffb74d;
            font-weight: 600;
        }

        tr:hover {
            background: #232323;
        }

        .badge-estado {
            background: #2e7d32;
            color: #fff;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            display: inline-block;
        }

        .empty-state {
            background: #252525;
            padding: 30px;
            text-align: center;
            border-radius: 8px;
            color: #aaa;
            margin: 20px 0;
            border: 1px dashed #444;
        }

        .form-card {
            margin-top: 30px;
            background: #252525;
            padding: 22px;
            border-radius: 8px;
            border-left: 4px solid #ff9800;
        }

        .form-card h3 {
            margin-top: 0;
            color: #ff9800;
            margin-bottom: 15px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 13px;
            color: #bbb;
            margin-bottom: 5px;
            font-weight: 500;
        }

        input,
        select {
            padding: 10px 12px;
            background: #333;
            border: 1px solid #4f4f4f;
            color: #fff;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
            width: 100%;
        }

        input:focus,
        select:focus {
            border-color: #ff9800;
        }

        .btn-submit {
            margin-top: 18px;
            width: 100%;
            padding: 12px;
            background: #ff9800;
            color: #121212;
            border: none;
            font-size: 15px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .btn-submit:hover {
            background: #ffa726;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header">
            <div>
                <h2>Panel de Gestión - ReserVa 🚀</h2>
                <small>Sesión activa: <strong><%= email %></strong></small>
            </div>
            <div>
                <a href="/" class="btn-nav btn-home">🏠 Inicio</a>
                <a href="/logout" class="btn-nav btn-logout">🚪 Cerrar Sesión</a>
            </div>
        </div>

        <!-- LISTADO DE RESERVAS -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px;">
            <h3 style="margin: 0; color: #fff;">Mis Reservas (<%= reservas.length %>)</h3>
        </div>

        <% if (reservas.length === 0) { %>
            <div class="empty-state">
                <p style="font-size: 17px; margin: 0; color: #fff;">📭 Aún no tienes reservas registradas.</p>
                <p style="font-size: 13px; margin: 8px 0 0 0;">Crea tu primera reserva usando el formulario de abajo.</p>
            </div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th># ID</th>
                        <th>Cliente</th>
                        <th>Plato / Ocasión</th>
                        <th>Mesa / Área</th>
                        <th>Fecha y Hora</th>
                        <th>Pers.</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <% reservas.forEach(r => { %>
                        <tr>
                            <td><small style="color: #888;"><%= r._id ? r._id.toString().slice(-6) : (r.id || '-') %></small></td>
                            <td><strong><%= r.cliente %></strong></td>
                            <td><%= r.plato %></td>
                            <td><%= r.mesa %></td>
                            <td><%= (r.fecha || '') %> <small style="color: #aaa;"><%= (r.hora || '') %></small></td>
                            <td><%= r.cantidad_personas || 1 %></td>
                            <td><span class="badge-estado"><%= r.estado || 'Confirmada' %></span></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>

        <!-- FORMULARIO NUEVA RESERVA -->
        <div class="form-card">
            <h3>➕ Crear Nueva Reserva</h3>
            <form action="/reservas/crear" method="POST">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="cliente">Nombre del Cliente</label>
                        <input type="text" id="cliente" name="cliente" value="<%= email %>" placeholder="Nombre o correo" required>
                    </div>

                    <div class="form-group">
                        <label for="plato">Plato u Ocasión</label>
                        <input type="text" id="plato" name="plato" placeholder="Ej: Cena romántica, Bandeja Paisa..." required>
                    </div>

                    <div class="form-group">
                        <label for="mesa">Mesa o Área</label>
                        <input type="text" id="mesa" name="mesa" placeholder="Ej: Mesa 1, Mesa 4, Terraza, VIP..." required>
                    </div>

                    <div class="form-group">
                        <label for="cantidad_personas">Número de Personas</label>
                        <input type="number" id="cantidad_personas" name="cantidad_personas" min="1" max="50" value="2" required>
                    </div>

                    <div class="form-group">
                        <label for="fecha">Fecha</label>
                        <input type="date" id="fecha" name="fecha" required>
                    </div>

                    <div class="form-group">
                        <label for="hora">Hora</label>
                        <input type="time" id="hora" name="hora" value="19:00" required>
                    </div>
                </div>

                <button type="submit" class="btn-submit">💾 Guardar Reserva</button>
            </form>
        </div>
    </div>

    <script>
        // Establecer la fecha actual por defecto en el input date
        const fechaInput = document.getElementById('fecha');
        if (fechaInput && !fechaInput.value) {
            const hoy = new Date().toISOString().split('T')[0];
            fechaInput.value = hoy;
        }
    </script>
</body>

</html>
